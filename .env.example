# ==========================================
# POLLHUB ENVIRONMENT CONFIGURATION
# ==========================================

# Application Environment
NODE_ENV=development
PORT=5000
CLIENT_URL=http://localhost:5173

# Database Configuration
# MongoDB connection URI (e.g. mongodb://localhost:27017/pollhub or MongoDB Atlas URI)
# If left blank in development, PollHub automatically boots an embedded MongoDB persistence engine
MONGODB_URI=

# JWT Secrets & Expirations (Must be kept secure in production)
JWT_ACCESS_SECRET=pollhub_super_secret_access_key_change_in_production_2026
JWT_REFRESH_SECRET=pollhub_super_secret_refresh_key_change_in_production_2026
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
COOKIE_SECRET=pollhub_cookie_secret_key_change_in_production

# Business & Timezone Configuration
DEFAULT_TIMEZONE=Asia/Kolkata
DEFAULT_POLL_START_TIME=11:00
DEFAULT_POLL_END_TIME=12:30

# ImageKit Configuration (For food photo uploads)
# If left blank, PollHub automatically uses secure local uploads with static asset delivery
IMAGEKIT_PUBLIC_KEY=
IMAGEKIT_PRIVATE_KEY=
IMAGEKIT_URL_ENDPOINT=

# Admin Bootstrap Credentials (Used by `npm run bootstrap:admin`)
ADMIN_BOOTSTRAP_ID=ADMIN001
ADMIN_BOOTSTRAP_NAME=System Administrator
ADMIN_BOOTSTRAP_PASSWORD=Admin@PollHub2026!
